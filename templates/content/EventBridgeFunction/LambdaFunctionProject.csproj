<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>
    <AWSProjectType>Lambda</AWSProjectType>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <Nullable>enable</Nullable>
<!--#if (aot)-->
    <OutputType>Exe</OutputType>
    <PublishAot>true</PublishAot>
    <StripSymbols>true</StripSymbols>
    <TrimMode>partial</TrimMode>
    <!-- Amazon.Lambda.Serialization.SystemTextJson ships both the AOT-safe
         SourceGeneratorLambdaJsonSerializer and the reflection-based DefaultLambdaJsonSerializer
         and LambdaJsonSerializer in one assembly. TrimMode=partial retains all types from the
         package (it is not marked Trimmable); the ILC emits IL3050 warnings for the unreachable
         reflection-based methods. With default TrimmerSingleWarn=true the ILC rolls these into a
         single IL3053 severity-error that fails warnaserror builds even though this application
         never calls those types.
         * TrimmerSingleWarn=false: emit individual IL3050 severity-warning diagnostics instead of
           the aggregate IL3053 error.
         * IlcTreatWarningsAsErrors=false: prevent the SDK from forwarding warnaserror to the ILC
           tool, so ILC itself emits warnings rather than errors.
         * WarningsNotAsErrors: passes nowarnaserr:IL3050 to ILC and tells MSBuild not to promote
           IL3050 to an error even when TreatWarningsAsErrors is active.
         All IL3050 warnings originate within the AWS package; only SourceGeneratorLambdaJsonSerializer
         is reachable at runtime in this application. Remove these three properties if the AWS package
         ships a trimming-annotated build of Amazon.Lambda.Serialization.SystemTextJson. -->
    <TrimmerSingleWarn>false</TrimmerSingleWarn>
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);IL3050</WarningsNotAsErrors>
<!--#else-->
    <PublishReadyToRun>true</PublishReadyToRun>
<!--#endif-->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Kralizek.Lambda.Template.EventBridge" Version="__KRALIZEK_LAMBDA_VERSION__" />
<!--#if (aot)-->
    <PackageReference Include="Amazon.Lambda.RuntimeSupport" Version="2.1.2" />
<!--#endif-->
  </ItemGroup>

<!--#if (otel)-->
  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.17.0" />
    <PackageReference Include="OpenTelemetry.Instrumentation.AWSLambda" Version="1.17.0" />
  </ItemGroup>
<!--#endif-->

</Project>
