{
  "author": "Renato Golia",
  "classifications": [
    "AWS",
    "Lambda",
    "SQS",
    "Function",
    "Template"
  ],
  "name": "AWS Lambda SQS Function",
  "identity": "Kralizek.Lambda.Template.SqsFunction",
  "groupIdentity": "Kralizek.Lambda.Template.SqsFunction.CSharp",
  "shortName": "lambda-template-sqs",
  "tags": {
    "language": "C#",
    "type": "project"
  },
  "sourceName": "LambdaFunctionProject",
  "preferNameDirectory": true,
  "symbols": {
    "profile": {
      "type": "parameter",
      "description": "The AWS credentials profile set in aws-lambda-tools-defaults.json and used as the default profile when interacting with AWS.",
      "datatype": "string",
      "replaces": "DefaultProfile",
      "defaultValue": ""
    },
    "region": {
      "type": "parameter",
      "description": "The AWS region set in aws-lambda-tools-defaults.json and used as the default region when interacting with AWS.",
      "datatype": "string",
      "replaces": "DefaultRegion",
      "defaultValue": ""
    },
    "role": {
      "type": "parameter",
      "description": "The AWS IAM role set in aws-lambda-tools-defaults.json and used as the default role when interacting with AWS.",
      "datatype": "string",
      "replaces": "DefaultRole",
      "defaultValue": ""
    },
    "otel": {
      "type": "parameter",
      "description": "Enable OpenTelemetry using the standard AWS Lambda instrumentation.",
      "datatype": "bool",
      "replaces": "EnableOpenTelemetry",
      "defaultValue": "false"
    },
    "raw": {
      "type": "parameter",
      "description": "Generate a handler for raw AWS SQS records instead of decoded message payloads.",
      "datatype": "bool",
      "defaultValue": "false"
    }
  },
  "sources": [
    {
      "modifiers": [
        {
          "condition": "raw",
          "exclude": [
            "OrderCreated.cs",
            "OrderCreatedHandler.cs"
          ]
        },
        {
          "condition": "!raw",
          "exclude": [
            "RawSqsRecordHandler.cs"
          ]
        }
      ]
    }
  ],
  "primaryOutputs": [
    { "path": "./LambdaFunctionProject.csproj" }
  ]
}