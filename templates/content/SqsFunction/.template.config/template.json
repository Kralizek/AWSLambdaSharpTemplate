{
  "author": "Renato Golia",
  "classifications": ["AWS", "Lambda", "SQS", "Function", "Template"],
  "name": "AWS Lambda SQS Function",
  "identity": "Kralizek.Lambda.Template.SqsFunction",
  "groupIdentity": "Kralizek.Lambda.Template.SqsFunction.CSharp",
  "shortName": "lambda-template-sqs",
  "tags": { "language": "C#", "type": "project" },
  "sourceName": "LambdaFunctionProject",
  "preferNameDirectory": true,
  "symbols": {
    "profile": { "type": "parameter", "datatype": "string", "replaces": "DefaultProfile", "defaultValue": "" },
    "region": { "type": "parameter", "datatype": "string", "replaces": "DefaultRegion", "defaultValue": "" },
    "role": { "type": "parameter", "datatype": "string", "replaces": "DefaultRole", "defaultValue": "" },
    "otel": { "type": "parameter", "description": "Enable OpenTelemetry using the standard AWS Lambda instrumentation.", "datatype": "bool", "defaultValue": "false" },
    "raw": { "type": "parameter", "description": "Generate a handler for raw AWS SQS records instead of decoded message payloads.", "datatype": "bool", "defaultValue": "false" },
    "aot": { "type": "parameter", "description": "Generate a Native AOT Lambda executable with source-generated JSON serialization.", "datatype": "bool", "defaultValue": "false" }
  },
  "sources": [{ "modifiers": [
    { "condition": "!aot", "exclude": ["Program.cs"] },
    { "condition": "raw", "exclude": ["OrderCreated.cs", "OrderCreatedHandler.cs"] },
    { "condition": "!raw", "exclude": ["RawSqsRecordHandler.cs"] }
  ] }],
  "primaryOutputs": [{ "path": "./LambdaFunctionProject.csproj" }]
}
