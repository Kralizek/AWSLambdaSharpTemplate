<Project Sdk="Microsoft.NET.Sdk">

  <Import Project="../eng/Package.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Kralizek.Lambda.Templates</PackageId>
    <PackageType>Template</PackageType>
    <Description>Templates for AWS Lambda using Kralizek.Lambda.Template</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <IncludeSymbols>false</IncludeSymbols>
    <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>
    <EnableDefaultItems>false</EnableDefaultItems>
    <TemplateStagingDirectory>$(IntermediateOutputPath)template-content</TemplateStagingDirectory>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None
      Include="content/**/*"
      Exclude="content/**/*.csproj"
      Pack="true"
      PackagePath="content/%(RecursiveDir)%(Filename)%(Extension)" />
    <None
      Include="$(TemplateStagingDirectory)/EventFunction/LambdaFunctionProject.csproj"
      Pack="true"
      PackagePath="content/EventFunction/LambdaFunctionProject.csproj" />
    <None
      Include="$(TemplateStagingDirectory)/RequestFunction/LambdaFunctionProject.csproj"
      Pack="true"
      PackagePath="content/RequestFunction/LambdaFunctionProject.csproj" />
    <None
      Include="$(TemplateStagingDirectory)/SnsFunction/LambdaFunctionProject.csproj"
      Pack="true"
      PackagePath="content/SnsFunction/LambdaFunctionProject.csproj" />
    <None
      Include="$(TemplateStagingDirectory)/SqsFunction/LambdaFunctionProject.csproj"
      Pack="true"
      PackagePath="content/SqsFunction/LambdaFunctionProject.csproj" />
  </ItemGroup>

  <Target Name="PrepareTemplateProjects" BeforeTargets="GenerateNuspec">
    <MakeDir Directories="$(TemplateStagingDirectory)/EventFunction;$(TemplateStagingDirectory)/RequestFunction;$(TemplateStagingDirectory)/SnsFunction;$(TemplateStagingDirectory)/SqsFunction" />
    <Copy
      SourceFiles="content/EventFunction/LambdaFunctionProject.csproj"
      DestinationFiles="$(TemplateStagingDirectory)/EventFunction/LambdaFunctionProject.csproj" />
    <Copy
      SourceFiles="content/RequestFunction/LambdaFunctionProject.csproj"
      DestinationFiles="$(TemplateStagingDirectory)/RequestFunction/LambdaFunctionProject.csproj" />
    <Copy
      SourceFiles="content/SnsFunction/LambdaFunctionProject.csproj"
      DestinationFiles="$(TemplateStagingDirectory)/SnsFunction/LambdaFunctionProject.csproj" />
    <Copy
      SourceFiles="content/SqsFunction/LambdaFunctionProject.csproj"
      DestinationFiles="$(TemplateStagingDirectory)/SqsFunction/LambdaFunctionProject.csproj" />

    <XmlPoke
      XmlInputPath="$(TemplateStagingDirectory)/EventFunction/LambdaFunctionProject.csproj"
      Query="/Project/ItemGroup/PackageReference[@Include='Kralizek.Lambda.Template']/@Version"
      Value="$(PackageVersion)" />
    <XmlPoke
      XmlInputPath="$(TemplateStagingDirectory)/RequestFunction/LambdaFunctionProject.csproj"
      Query="/Project/ItemGroup/PackageReference[@Include='Kralizek.Lambda.Template']/@Version"
      Value="$(PackageVersion)" />
    <XmlPoke
      XmlInputPath="$(TemplateStagingDirectory)/SnsFunction/LambdaFunctionProject.csproj"
      Query="/Project/ItemGroup/PackageReference[@Include='Kralizek.Lambda.Template.Sns']/@Version"
      Value="$(PackageVersion)" />
    <XmlPoke
      XmlInputPath="$(TemplateStagingDirectory)/SqsFunction/LambdaFunctionProject.csproj"
      Query="/Project/ItemGroup/PackageReference[@Include='Kralizek.Lambda.Template.Sqs']/@Version"
      Value="$(PackageVersion)" />
  </Target>

</Project>